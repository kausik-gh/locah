# ==============================================================================
# PLATFORM ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Do NOT insert real credentials/secrets here.
# ==============================================================================

# Supabase Managed Infrastructure
SUPABASE_URL=http://127.0.0.1:54321   # SERVER ONLY. API derives the JWKS URL from this
                                     # (<SUPABASE_URL>/auth/v1/.well-known/jwks.json).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsIn... # SERVER ONLY (never expose to client)
# Legacy HS256 secret. The hosted project signs real tokens with an asymmetric
# ES256 key (verified via JWKS from SUPABASE_URL); this only covers pre-migration
# tokens still in TTL and the test suite's own HS256 tokens. NOT the Key ID / kid.
SUPABASE_JWT_SECRET=your-legacy-supabase-jwt-secret # SERVER ONLY
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
# Optional. When set, the API connects as the NOBYPASSRLS `platform_api` role
# instead of `postgres`, so RLS policies are actually enforced (AUD-02). Unset
# = the pre-AUD-02 bypass behaviour. See infra/deploy/README.md §3.
# API_DATABASE_URL=postgresql+asyncpg://platform_api:your-platform-api-password@127.0.0.1:54322/postgres

# App Server & Clients configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WORKSPACE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Platform Context Configuration
PLATFORM_DOMAIN=localhost
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost
ENVIRONMENT=local # local | test | staging | production

# AI Provider Configurations (server-side only — never expose to Next.js/browser)
AI_PROVIDER=xai # xai | grok
XAI_API_KEY=your-xai-api-key # SERVER ONLY
XAI_MODEL=grok-3-mini # SERVER ONLY (override for staging/production tuning)

# Payment Provider Configurations (Razorpay selected as default)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-razorpay-key-secret # SERVER ONLY — platform account, not merchant keys
# Basis points withheld as the LOCAH platform fee on Route transfers (0–10000). 0 until commercially set.
RAZORPAY_PLATFORM_FEE_BPS=0
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-hmac-secret # SERVER ONLY (Stage 9 webhook verification)
WEBSITE_PREVIEW_SECRET=your-website-preview-hmac-secret # SERVER ONLY (Stage 2 preview tokens)

# Email & SMS Gateway Configurations
EMAIL_PROVIDER=resend # resend | mock
RESEND_API_KEY=re_... # SERVER ONLY
SMS_PROVIDER=msg91 # msg91 | mock
MSG91_AUTH_KEY=your-msg91-auth-key # SERVER ONLY

# Worker Settings
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_CLAIM_BATCH_SIZE=10
WORKER_LEASE_SECONDS=120

# Observability Configuration
SENTRY_DSN=https://your-sentry-dsn
OTEL_ENDPOINT=http://localhost:4317
